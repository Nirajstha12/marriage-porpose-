<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>A Promise For Our Future</title>
    <style>
        body {
            font-family: 'Playfair Display', 'Georgia', serif;
            background: linear-gradient(135deg, #fff5f5 0%, #ffe3e3 100%);
            color: #2b1b1d;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            margin: 0;
            padding: 20px;
            box-sizing: border-box;
        }

        .container {
            background: rgba(255, 255, 255, 0.95);
            padding: 45px;
            border-radius: 30px;
            box-shadow: 0 20px 50px rgba(214, 51, 132, 0.08);
            text-align: center;
            max-width: 500px;
            width: 100%;
            position: relative;
            border: 1px solid rgba(255, 182, 193, 0.4);
        }

        h1 {
            font-size: 32px;
            color: #9c2c46;
            margin-bottom: 10px;
            font-weight: 700;
        }

        p {
            font-size: 18px;
            color: #5c4d50;
            line-height: 1.6;
        }

        .step {
            display: none;
        }

        .step.active {
            display: block;
        }

        /* BUTTON LAYOUT FOR STEP 1 */
        .proposal-actions {
            display: flex;
            justify-content: center;
            gap: 30px;
            margin-top: 40px;
            position: relative;
            min-height: 70px;
        }

        button {
            font-family: 'Helvetica Neue', Arial, sans-serif;
            padding: 14px 36px;
            font-size: 18px;
            border: none;
            border-radius: 50px;
            cursor: pointer;
            font-weight: 600;
            letter-spacing: 0.5px;
            transition: all 0.3s ease;
        }

        .btn-yes {
            background-color: #d63384;
            color: white;
            box-shadow: 0 5px 15px rgba(214, 51, 132, 0.3);
        }

        .btn-yes:hover {
            transform: translateY(-2px);
            background-color: #b8256f;
        }

        .btn-no {
            background-color: #f8f9fa;
            color: #6c757d;
            border: 1px solid #dee2e6;
            position: absolute;
            transition: all 0.15s ease;
        }

        /* MULTIPLE CHOICE STYLING */
        .choices-list {
            display: flex;
            flex-direction: column;
            gap: 12px;
            margin: 30px 0;
        }

        .choice-row {
            border: 1px solid #ebd3d6;
            border-radius: 15px;
            padding: 16px;
            cursor: pointer;
            font-size: 18px;
            background-color: white;
            transition: all 0.25s ease;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .choice-row:hover {
            background-color: #fff0f2;
            border-color: #ffb3c1;
        }

        .choice-row input {
            display: none;
        }

        .choice-row.selected {
            background-color: #ffe3e8;
            border-color: #d63384;
            color: #9c2c46;
            font-weight: 600;
        }

        .btn-continue {
            background-color: #2b1b1d;
            color: white;
            width: 100%;
            margin-top: 15px;
        }

        .btn-continue:hover {
            background-color: #422d30;
        }

        /* EXTRA STYLING FOR THE FINAL SCREEN */
        .heart-icon {
            font-size: 50px;
            color: #d63384;
            margin-bottom: 20px;
            animation: pulse 1.5s infinite;
        }

        @keyframes pulse {
            0% { transform: scale(1); }
            50% { transform: scale(1.15); }
            100% { transform: scale(1); }
        }
    </style>
</head>
<body>

